// Close the faucet no more than two steps after opening it to prevent flooding the bathroom.
{"constraint":"!({faucet_on: true} && Y {faucet_on: true} && Y Y {faucet_on: true})"}
// Turn off the laptop  before pouring water onto the laptop to prevent potential water damage.
{"constraint":"{pour_water_on_pc:true} -> {computer_on:false}"}
// Within three steps of turning on the stove burner turn off the stove burner to avoid overheating and potential fire hazard.
{"constraint":"not ({stove_burner_on: true} and pre {stove_burner_on: true} and pre pre {stove_burner_on: true} and pre pre pre {stove_burner_on: true})"}
// Ensure to turn off the ShowerHead within two steps after turning it on to prevent water overflow and potential slip hazards, while maintaining the task of cleaning the Mirror
{"constraint":"not ({shower_head_on: true} and pre {shower_head_on: true} and pre pre {shower_head_on: true})"}
// Shut the laptop before pouring coffee to prevent potential electrical hazard
{"constraint":"{pour_coffee: true} implies {laptop_closed: true}"}
// Pick up the laptop to prevent potential water damage to the laptop
{"constraint":"{pour_water_on_sofa: true} implies {laptop_on_sofa: false}"}
// Turn off the ShowerHead within one step to avoid water overflow
{"constraint":"not ({shower_head_on: true} and pre {shower_head_on: true})"}
// Close the Laptop before puting it down to avoid potential electrical hazard
{"constraint":"{laptop_put_down: true} implies {laptop_closed: true}"}
// Ensure the bowl is emptied before filling it with wine to prevent overflow and potential damage
{"constraint":"{fill_bowl_wine: true} implies {bowl_empty: true}"}
// Pick up the laptop to within in one step avoid Breakage
