// Take out the potato and clean the bowl before filling it with water to avoid poisoning
{"constraint":"{fill_bowl_water: true} implies ({potato_in_bowl: false} and {bowl_clean: true})"}
// Turn off the stove burner immediately after the potato is cooked to avoid overheat
{"constraint":"pre {potato_cooked: true} implies {stove_burner_on: false}"}
// Turn off the stove burner before pouring the water
{"constraint":"{pour_water: true} implies {stove_burner_on: false}"}
// Take out the book before turn on the faucet to avoid damaging the book
